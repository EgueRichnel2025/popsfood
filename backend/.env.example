# Base de données : SQLite par défaut (local). Pour la prod, utilisez PostgreSQL :
# DATABASE_URL=postgresql://user:password@host:5432/popsfood
DATABASE_URL=sqlite:///./popsfood.db

# Secret utilisé pour signer les tokens JWT admin - CHANGEZ CETTE VALEUR EN PRODUCTION
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_MINUTES=480

# Dossier de stockage des images/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# URL du frontend autorisée en CORS
FRONTEND_ORIGIN=http://localhost:5173
# URL publique du frontend, utilisée dans le lien envoyé par email pour réinitialiser un mot de passe
FRONTEND_URL=https://popsfood.vercel.app
# Envoi d'emails (réinitialisation de mot de passe en libre-service pour les admins).
# Exemple avec Gmail (gratuit) :
#   1. Activez la validation en 2 étapes sur le compte Gmail utilisé
#   2. Créez un "mot de passe d'application" : https://myaccount.google.com/apppasswords
#   3. Utilisez ce mot de passe d'application ci-dessous (pas le mot de passe Gmail normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=richnelegue@gmail.com
SMTP_PASSWORD=xpsx hlnz viee ypvw
SMTP_FROM_EMAIL=richnelegue@gmail.com
SMTP_FROM_NAME=Pop's FOOD BENIN
